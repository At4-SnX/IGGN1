# ─── Bot ───────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=

# ─── Accès ─────────────────────────────────────────────
# Rôle IGGN : peut avertir, sanctionner, promouvoir, décorer, consulter les dossiers
ROLE_IGGN_ID=
# Rôle de la direction (optionnel) : retrait du service, rétrogradation, levée de sanction.
# S'il est absent, le rôle IGGN suffit.
ROLE_DIRECTION_ID=
# Rôle des militaires autorisés à rendre un compte rendu (optionnel, sinon tout le monde)
ROLE_PERSONNEL_ID=

# ─── Dossiers du personnel (un fil par officier) ───────
FORUM_DOSSIERS_ID=

# ─── Grades : IDs des rôles séparés par des virgules, du PLUS BAS au PLUS HAUT ─
# Ex : GRADE_ROLE_IDS=111,222,333,444
GRADE_ROLE_IDS=

# ─── Rôles de sanction ─────────────────────────────────
ROLE_AVERTISSEMENT_ID=
ROLE_SUSPENDU_ID=
ROLE_MISE_A_PIED_ID=
ROLE_RETIRE_ID=

# ─── Registres publics (salon OU forum, tous optionnels) ─
CHANNEL_AVERTISSEMENTS_ID=
CHANNEL_SANCTIONS_ID=
CHANNEL_PROMOTIONS_ID=
CHANNEL_RETROGRADATIONS_ID=
CHANNEL_HONNEURS_ID=
CHANNEL_COMPTES_RENDUS_ID=

# ─── Journal d'audit (optionnel) ───────────────────────
LOG_CHANNEL_ID=

# ─── Effectifs par grade sur le dashboard (optionnel) ──
# true = nécessite d'activer "Server Members Intent" dans le Developer Portal
ENABLE_MEMBERS_INTENT=false

# ─── Statut streaming (lien Twitch ou YouTube) ─────────
STREAM_URL=https://www.twitch.tv/gendarmerienationale

# ─── Stockage (Railway : monter un Volume, ex: /data) ──
DATA_DIR=./data
